---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const news = (await getCollection('news')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout title="Home">
  <section class="mb-10">
    <h1 class="text-3xl font-bold text-slate-900">Welkom bij Spora Leuven</h1>
    <p class="mt-2 text-slate-600">
      Volleybalclub voor jong en oud in Leuven en omstreken. Kom kijken, meetrainen of word lid!
    </p>
  </section>

  <section>
    <h2 class="mb-4 text-xl font-semibold text-slate-900">Laatste nieuws</h2>
    <div class="flex flex-col gap-6">
      {news.map((post) => (
        <article class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
          <h3 class="text-lg font-semibold text-slate-900">{post.data.title}</h3>
          <p class="text-xs text-slate-400">
            {post.data.date.toLocaleDateString('nl-BE', { day: 'numeric', month: 'long', year: 'numeric' })}
          </p>
          <p class="mt-2 text-slate-600">{post.data.summary}</p>
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
