---
import BaseLayout from '../layouts/BaseLayout.astro';
import { fuifPhotos, photos } from '../data/historyPhotos';
---

<BaseLayout title="De oude doos">
  <h1 class="text-3xl font-bold text-slate-900">De oude doos</h1>
  <p class="mt-2 text-slate-600">Een blik op onze mooiste momenten door de jaren heen.</p>

  <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {photos.map((photo, index) => (
      <figure class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
        <a href={`/history/images/${index + 1}`}>
          <img src={photo.src} alt={photo.caption} class="h-48 w-full object-cover" />
        </a>
        <figcaption class="px-4 py-3 text-sm text-slate-600">
          <span class="font-semibold text-slate-900">{photo.year}</span> — {photo.caption}
        </figcaption>
      </figure>
    ))}
  </div>

  <section class="mt-12">
    <h2 class="text-2xl font-bold text-slate-900">Spora fuif 200? - Zaal Pacem</h2>
    <div class="mt-6 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {fuifPhotos.map((photo, index) => (
        <figure class="overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
          <a href={`/history/images/${photos.length + index + 1}`}>
            <img src={photo.src} alt={photo.caption} class="h-48 w-full object-cover" />
          </a>
          <figcaption class="px-4 py-3 text-sm text-slate-600">{photo.caption}</figcaption>
        </figure>
      ))}
    </div>
  </section>
</BaseLayout>
