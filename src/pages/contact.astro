---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const gyms = await getCollection('gyms');
---

<BaseLayout title="Contact">
  <h1 class="text-3xl font-bold text-slate-900">Contact</h1>

  <section class="mt-6 rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
    <h2 class="text-lg font-semibold text-slate-900">Algemene contactgegevens</h2>
    <p class="mt-2 text-slate-600">
      Voor alle vragen kan je terecht op&nbsp;
      <a href="mailto:info@sporaleuven.be" class="text-orange-600 hover:underline">info@sporaleuven.be</a>.
    </p>
  </section>

  <section class="mt-8">
    <h2 class="mb-4 text-xl font-semibold text-slate-900">Onze sporthallen</h2>
    <div class="grid gap-6 sm:grid-cols-2">
      {gyms.map((gym) => (
        <div class="rounded-lg border border-slate-200 bg-white p-5 shadow-sm">
          <h3 class="text-lg font-semibold text-slate-900">{gym.data.name}</h3>
          <p class="text-slate-600">{gym.data.address}</p>
          <p class="text-slate-600">{gym.data.city}</p>
          <p class="mt-2 text-sm text-slate-500">{gym.data.notes}</p>
          <iframe
            src={`https://maps.google.com/maps?q=${encodeURIComponent(`${gym.data.address}, ${gym.data.city}`)}&output=embed`}
            class="mt-3 h-48 w-full rounded-md border border-slate-200"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title={`Kaart ${gym.data.name}`}
          ></iframe>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
